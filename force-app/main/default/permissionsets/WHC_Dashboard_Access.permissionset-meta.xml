<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>WHC Dashboard Access</label>
    <description>Grants access to the Cadence Email Performance, Cadence Step Progression, and Industry Assignment dashboard components.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>CadenceEmailDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CadenceStepProgressionController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>IndustryAssignmentController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
